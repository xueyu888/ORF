{
  "name": "orf",
  "version": "0.0.45",
  "private": true,
  "description": "ORF project management tool built from ORF documentation.",
  "bin": {
    "orf": "./bin/orf.mjs"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "orf": "node scripts/with-public-ca.mjs node bin/orf.mjs",
    "cli:link": "node scripts/link-orf-cli.mjs",
    "check:env": "uv --version && node --version && npm --version",
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "server:dev": "node scripts/with-public-ca.mjs tsx watch server/index.ts",
    "server:start": "node scripts/with-public-ca.mjs tsx server/index.ts",
    "test": "node scripts/with-public-ca.mjs tsx --test tests/*.test.ts",
    "testd": "node testd/_tools/with-global-lock.mjs -- node scripts/run-testd.mjs",
    "testd:parallel": "TESTD_SUITE=parallel node testd/_tools/with-global-lock.mjs -- node scripts/run-testd.mjs",
    "testd:serial": "TESTD_SUITE=serial node testd/_tools/with-global-lock.mjs -- node scripts/run-testd.mjs --workers=1",
    "test:e2e": "npm run testd",
    "test:e2e:explorer": "node scripts/with-public-ca.mjs playwright test e2e/ui-random-explorer.spec.ts",
    "test:e2e:explorer:fast": "node scripts/with-public-ca.mjs tsx scripts/run-ui-explorer-parallel.ts",
    "test:e2e:explorer:live": "node scripts/with-public-ca.mjs tsx scripts/run-ui-explorer-live.ts",
    "verify": "npm run build && npm test && npm run test:e2e",
    "ory:dev": "tsx scripts/prepare-ory-env.ts && sg docker -c 'docker compose -f docker-compose.ory.yml up -d kratos'",
    "ory:down": "sg docker -c 'docker compose -f docker-compose.ory.yml down'",
    "storage:dev": "docker compose -f docker-compose.minio.yml up -d",
    "storage:down": "docker compose -f docker-compose.minio.yml down",
    "storage:logs": "docker compose -f docker-compose.minio.yml logs -f minio",
    "infra:public:env": "node scripts/configure-public-ip-env.mjs",
    "infra:public:prepare": "node scripts/prepare-public-ip-infra.mjs",
    "infra:public:up": "npm run build && npm run infra:public:prepare && tsx scripts/prepare-ory-env.ts && docker compose -f docker-compose.ory.yml -f docker-compose.minio.yml -f docker-compose.public.yml up -d kratos minio minio-init public-gateway",
    "infra:public:down": "docker compose -f docker-compose.ory.yml -f docker-compose.minio.yml -f docker-compose.public.yml down",
    "infra:public:cert:staging": "node scripts/public-ip-cert.mjs --staging",
    "infra:public:cert:issue": "node scripts/public-ip-cert.mjs",
    "infra:public:cert:renew": "node scripts/public-ip-cert.mjs --renew",
    "infra:public:domain-cert:staging": "node scripts/public-domain-cert.mjs --staging",
    "infra:public:domain-cert:issue": "node scripts/public-domain-cert.mjs",
    "infra:public:domain-cert:renew": "node scripts/public-domain-cert.mjs --renew",
    "infra:public:domain-cert:install-renewal": "node scripts/install-public-domain-renewal.mjs",
    "infra:public:duckdns:update": "node scripts/update-duckdns-domain.mjs",
    "db:local": "echo 'Local Postgres is disabled. Use DATABASE_URL in .env.' && exit 1",
    "db:local:down": "echo 'Local Postgres is disabled. Use DATABASE_URL in .env.'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:push": "drizzle-kit push",
    "db:audit:leaderboard": "tsx scripts/audit-leaderboard-data.ts",
    "gitlab:orf-chat:reconcile": "node scripts/with-public-ca.mjs tsx scripts/reconcile-gitlab-orf-chat.ts",
    "notify:email": "tsx scripts/send-email-notification.ts",
    "push:diagnose": "node scripts/with-public-ca.mjs tsx scripts/diagnose-push.ts",
    "client:icons:generate": "node scripts/generate-client-icons.mjs",
    "client:sync-versions": "node scripts/sync-client-versions.mjs",
    "client:desktop:dev": "electron clients/desktop/main.cjs",
    "client:desktop:pack:linux": "node scripts/build-desktop-client.mjs --dir --linux",
    "client:desktop:dist:win": "node scripts/build-desktop-client.mjs --win nsis --x64",
    "client:android:sync": "npm run client:sync-versions && npm run build && cap sync android && node scripts/configure-android-push.mjs",
    "client:android:assemble:debug": "npm run client:android:sync && node scripts/with-android-env.mjs --cwd android -- ./gradlew assembleDebug",
    "client:android:assemble:release": "npm run client:android:sync && node scripts/with-android-env.mjs --cwd android -- ./gradlew assembleRelease",
    "client:android:env:setup": "node scripts/setup-android-validation-env.mjs",
    "client:env:check": "node scripts/check-client-validation-env.mjs",
    "release:clients": "node scripts/release-clients.mjs",
    "build": "node scripts/with-public-ca.mjs tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run check:env && npm run build"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "firebase-admin": "^13.10.0",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^1.11.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "zod": "^4.4.1"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.0",
    "@capacitor/cli": "8.4.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "electron": "42.3.3",
    "electron-builder": "26.15.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
