{
  "name": "orf",
  "version": "0.1.0",
  "private": true,
  "description": "ORF project management tool built from ORF documentation.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "check:env": "uv --version && node --version && npm --version",
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "ory:dev": "tsx scripts/prepare-ory-env.ts && sg docker -c 'docker compose -f docker-compose.ory.yml up -d kratos'",
    "ory:down": "sg docker -c 'docker compose -f docker-compose.ory.yml down'",
    "db:local": "sg docker -c 'docker compose -f docker-compose.ory.yml up -d --wait postgres'",
    "db:local:down": "sg docker -c 'docker compose -f docker-compose.ory.yml stop postgres'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run check:env && npm run build"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "lucide-react": "^1.11.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
