# Copy this file to .env and fill local values.
# Never commit real database, Ory, object storage, messaging, GitHub, GitLab, Jira, or SMTP secrets.

# Required project configuration.

# Core external PostgreSQL connection.
DATABASE_URL=postgresql://orf_user:replace-me@db.example.com:5432/orf?sslmode=verify-full&sslrootcert=./certs/orf-postgres-root.crt&options=-csearch_path%3Dorf_current%2Cpublic
# DATABASE_URL and REMOTE_DATABASE_URL are both supported; DATABASE_URL takes precedence.
# REMOTE_DATABASE_URL=postgresql://orf_user:replace-me@db.example.com:5432/orf
# Database timeouts keep local pages from hanging when the remote database is unreachable.
DATABASE_POOL_MAX=30
# TestD direct database helpers use their own pool, separate from the ORF backend pool.
TESTD_DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=10000
# TestD may wait for role-permission advisory locks when multiple developers share PG/Ory/MinIO.
# Optional: override Playwright per-case timeout. Defaults: isolated 60000, permissions/settings 180000.
# TESTD_TEST_TIMEOUT_MS=180000
TESTD_ROLE_PERMISSION_LOCK_TIMEOUT_MS=300000

# Local ORF backend/frontend.
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
ORF_APP_URL=http://127.0.0.1:5173

# ORF backend proxy target for the shared anonymous peer-review settlement service.
# Browser clients always call /api/local-settlement on ORF; they must not call this
# private service directly.
ORF_LOCAL_SETTLEMENT_SERVICE_URL=http://127.0.0.1:8799
# Shared LAN service mode, when the private service is bound on the ORF host.
# ORF_LOCAL_SETTLEMENT_SERVICE_URL=http://199.199.199.8:8799
ORF_LOCAL_SETTLEMENT_TIMEOUT_MS=5000

# Core external Ory/MinIO connection.
ORY_PUBLIC_URL=https://ory.example.com
# Required only when deleting a linked user account, because Ory identity deletion uses the Kratos admin API.
# ORY_ADMIN_URL=https://ory-admin.example.com
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://minio.example.com
ORF_PUBLIC_CA_CERT=./.orf/shared-infra/certs/orf-public-ca.crt
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=orf-comment-attachments
OBJECT_STORAGE_ACCESS_KEY=orf-app
OBJECT_STORAGE_SECRET_KEY=replace-with-shared-minio-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
ORF_INFRA_UPLOAD_MAX_BYTES=10737418240
OBJECT_STORAGE_UPLOAD_MAX_BYTES=10485760
ORF_DRIVE_PREVIEW_MAX_BYTES=52428800
ORF_DRIVE_PREVIEW_LIBREOFFICE_BIN=soffice
ORF_DRIVE_PREVIEW_CONVERSION_TIMEOUT_MS=60000

# Optional: Android background push notifications. Keep disabled until Firebase
# Cloud Messaging is configured for org.duckdns.orfxueyu.orf.
ORF_PUSH_ENABLED=false
# private: notification shade shows generic text only; preview: includes ORF notification preview text.
ORF_PUSH_CONTENT_MODE=private
# Optional Android client config. Base64 encode android/app/google-services.json
# when building release APKs outside a checked-out local Firebase config file.
# ORF_ANDROID_GOOGLE_SERVICES_JSON_BASE64=base64-encoded-google-services-json
# Use exactly one Firebase service account source. Do not commit the real file.
# ORF_FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/orf-firebase-service-account.json
# ORF_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
# Optional: proxy used only by Firebase Admin SDK outbound requests.
# Defaults to HTTPS_PROXY/https_proxy/HTTP_PROXY/http_proxy when unset.
# ORF_FIREBASE_HTTP_PROXY=http://127.0.0.1:7890
ORF_CLIENT_UPDATE_PUSH_ENABLED=true
ORF_CLIENT_UPDATE_PUSH_POLL_INTERVAL_MS=600000
ORF_NOTIFICATION_DELIVERY_RETRY_INTERVAL_MS=60000
# Durable chat realtime/push outbox retry and expired-lease recovery interval.
ORF_CHAT_DELIVERY_RETRY_INTERVAL_MS=15000
# ORF-hosted client release catalog and installer/APK assets.
# The local release script writes the manifest and assets here after GitHub
# Actions builds mirror packages; GitHub Release remains a public mirror/fallback.
ORF_CLIENT_UPDATE_ASSET_DIR=.orf/client-updates
# Runtime user preferences, system settings, and uploaded visual backgrounds.
# This must stay outside public/, dist/, .artifacts/, and Android assets.
ORF_SETTINGS_DATA_DIR=.orf/settings
# Defaults to ORF_APP_URL. Set only when update downloads should use a
# different public ORF base URL.
# ORF_CLIENT_UPDATE_DOWNLOAD_BASE_URL=https://orf-xueyu.duckdns.org:8443/
# Required for client releases: separate shared secret used by release:clients
# --watch to publish the release manifest and upload installer/APK assets to ORF.
# Configure the same value on the running ORF server and on the release publisher.
# ORF_CLIENT_UPDATE_PUBLISH_SECRET=replace-with-long-random-client-update-publish-secret
# Optional publish target. Defaults to ORF_APP_URL when unset.
# ORF_CLIENT_UPDATE_PUBLISH_URL=https://orf-xueyu.duckdns.org:8443/
# Optional: shared secret used by release:clients --watch to broadcast the exact published client version.
# Configure the same value on the running ORF server and the machine that runs the release script.
# ORF_CLIENT_UPDATE_BROADCAST_SECRET=replace-with-long-random-client-update-broadcast-secret
# Optional release-script target. Defaults to ORF_APP_URL when unset.
# ORF_CLIENT_UPDATE_BROADCAST_URL=https://orf-xueyu.duckdns.org:8443/

# Optional: OpenAI-compatible LLM used only for admin work-log classification hints.
# If unset, ORF falls back to known local aio model env files when present.
# ORF_LLM_BASE_URL=http://127.0.0.1:9090/v1
# ORF_LLM_API_KEY=replace-with-local-llm-api-key
# ORF_LLM_MODEL=qwen3.5-mtp-4card
ORF_LLM_TIMEOUT_MS=8000

# Optional: ORF work-log debt reminder. Keep disabled until work-day calendar
# overrides and required-member settings are modeled. When enabled, 17:20 is the
# daily due boundary; active debt can remind every 10 minutes until 24:00,
# without creating repeated notification-center entries.
ORF_WORK_LOG_REMINDER_ENABLED=false
ORF_WORK_LOG_REMINDER_TIME_ZONE=Asia/Shanghai
ORF_WORK_LOG_REMINDER_HOUR=17
ORF_WORK_LOG_REMINDER_MINUTE=20
ORF_WORK_LOG_REMINDER_END_HOUR=24
ORF_WORK_LOG_REMINDER_END_MINUTE=0
ORF_WORK_LOG_REMINDER_POLL_INTERVAL_MS=60000
ORF_WORK_LOG_REMINDER_SNOOZE_MINUTES=10
ORF_WORK_LOG_REMINDER_WINDOW_DAYS=7

# Optional configuration.

# Optional: local/shared Ory runtime preparation. Not needed when ORF only consumes an external Ory service.
# Optional Ory-specific database URL. Defaults to DATABASE_URL/REMOTE_DATABASE_URL.
# Use this when ORF backend and Ory run across different network namespaces.
# ORY_DATABASE_URL=postgresql://orf_user:replace-me@postgres:5432/orf?options=-csearch_path%3Dorf_current%2Cpublic
# Optional host-reachable probe URL used only while generating Ory runtime env.
# ORY_DATABASE_PROBE_URL=postgresql://orf_user:replace-me@127.0.0.1:5432/orf?options=-csearch_path%3Dorf_current%2Cpublic
# ORY_DATABASE_POOL_MAX=6
# ORY_DATABASE_POOL_IDLE_MAX=2
# ORY_DATABASE_POOL_IDLE_TIME=5m
# ORY_DATABASE_POOL_CONN_LIFETIME=30m

# Optional: legacy/local backtest database.
# BACKTEST_DB_URL=postgresql://postgres:replace-me@127.0.0.1:5432/stock_backtest

# Optional: public-infra operator settings. Keep commented unless you are preparing the shared host.
# ORF_PUBLIC_IP=203.0.113.10
# Optional: extra IP SANs for LAN clients when router NAT loopback is unreliable.
# ORF_PUBLIC_GATEWAY_CERT_EXTRA_IPS=199.199.199.8
# ORF_WEB_EXTERNAL_PORT=8443
# ORF_DUCKDNS_DOMAIN=your-subdomain.duckdns.org
# ORF_DUCKDNS_TOKEN=replace-with-duckdns-token
# ORF_DUCKDNS_PROPAGATION_SECONDS=120
# ORF_LETSENCRYPT_EMAIL=admin@example.com
# ORY_PUBLIC_EXTERNAL_PORT=18443
# OBJECT_STORAGE_EXTERNAL_PORT=19443
# ORY_COOKIE_SECRET=replace-with-random-48-byte-secret
# ORY_CIPHER_SECRET=replace-with-random-32-char-secret
# MINIO_ROOT_USER=orf-root
# MINIO_ROOT_PASSWORD=replace-with-strong-local-secret

# Optional: GitHub push/issues -> ORF native chat channel.
# GITHUB_ORF_CHAT_ENABLED=false
# GITHUB_ORF_CHAT_CHANNEL_ID=replace-with-existing-orf-chat-channel-id
# GITHUB_ORF_CHAT_CHANNEL_NAME=github
# GITHUB_ORF_CHAT_CHANNEL_DISPLAY_NAME=GitHub
# GITHUB_ORF_CHAT_CHANNEL_TYPE=public
# GITHUB_ORF_CHAT_CHANNEL_PURPOSE=GitHub repository activity
# GITHUB_ORF_CHAT_CHANNEL_HEADER=GitHub repository activity
# GITHUB_ORF_CHAT_BOT_NAME=GitHub
# GITHUB_ORF_CHAT_BOT_EMAIL=github@orf.local
# GITHUB_ORF_CHAT_WEBHOOK_MAX_BODY_BYTES=1048576
# GITHUB_REPOSITORY_FULL_NAME=xueyu888/ORF
# GITHUB_SYNC_ENABLED=false
# GITHUB_SYNC_BRANCH=*
# GITHUB_SYNC_INTERVAL_SECONDS=60
# GITHUB_SYNC_LOOKBACK=20
# GITHUB_SYNC_STATE_FILE=.artifacts/github-sync-state.json
# GITHUB_SYNC_GIT_REMOTE=origin
# GITHUB_ISSUES_SYNC_ENABLED=false
# GITHUB_ISSUES_SYNC_INTERVAL_SECONDS=300
# GITHUB_ISSUES_SYNC_LOOKBACK=50
# GITHUB_TOKEN=replace-me
# GITHUB_WEBHOOK_SECRET=replace-me-with-random-32-byte-string

# Optional: GitLab projects -> ORF native chat channels.
# GITLAB_ORF_CHAT_ENABLED=false
# GITLAB_URL=https://gitlab.example.com
# GITLAB_ORF_CHAT_GROUP=develop
# GITLAB_ORF_CHAT_RECONCILE_INTERVAL_SECONDS=60
# GITLAB_ORF_CHAT_ACCESS_TOKEN=replace-with-gitlab-api-token
# GITLAB_ORF_CHAT_WEBHOOK_URL=https://orf.example.com/webhooks/gitlab/orf-chat
# GITLAB_ORF_CHAT_WEBHOOK_SECRET=replace-with-random-gitlab-webhook-token
# GITLAB_ORF_CHAT_SIGNING_TOKEN=whsec_replace-with-gitlab-standard-webhook-token
# GITLAB_ORF_CHAT_HOOK_MODE=group
# GITLAB_ORF_CHAT_WEBHOOK_MAX_BODY_BYTES=1048576
# GITLAB_ORF_CHAT_BOT_NAME=GitLab
# GITLAB_ORF_CHAT_BOT_EMAIL=gitlab@orf.local
# JIRA_TEMPO_MY_WORK_URL="https://jira.example.com/secure/Tempo.jspa#/my-work/week?type=LIST"

# Optional: SMTP email notifications.
# TDX_MAIL_SMTP_HOST=smtp.example.com
# TDX_MAIL_SMTP_PORT=465
# TDX_MAIL_SMTP_USER=notifications@example.com
# TDX_MAIL_SMTP_PASS=change-me
# TDX_MAIL_FROM="ORF <notifications@example.com>"
# TDX_MAIL_TO=owner@example.com
# TDX_MAIL_SMTP_SECURE=true
