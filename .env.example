# Copy this file to .env and replace placeholders with local/test credentials.
# Never commit real database, messaging, GitHub, or SMTP secrets.
DATABASE_URL=postgresql://orf_user:replace-me@db.example.com:5432/orf?sslmode=verify-full&sslrootcert=./certs/orf-postgres-root.crt&options=-csearch_path%3Dorf_current%2Cpublic
# DATABASE_URL and REMOTE_DATABASE_URL are both supported; DATABASE_URL takes precedence.
# REMOTE_DATABASE_URL=postgresql://orf_user:replace-me@db.example.com:5432/orf
# Database timeouts keep local pages from hanging when the remote database is unreachable.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
# Ory Kratos uses the same PostgreSQL instance in development. Keep its pool bounded so auth does not starve ORF API tests.
ORY_DATABASE_POOL_MAX=6
ORY_DATABASE_POOL_IDLE_MAX=2
ORY_DATABASE_POOL_IDLE_TIME=5m
ORY_DATABASE_POOL_CONN_LIFETIME=30m
BACKTEST_DB_URL=postgresql://postgres:replace-me@127.0.0.1:5432/stock_backtest
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
ORF_APP_URL=http://127.0.0.1:5173
# Browser-side anonymous peer review submission target. This service stores the private key under ~/.orf/local-settlement by default.
VITE_ORF_LOCAL_SETTLEMENT_URL=http://127.0.0.1:8799
ORF_LOCAL_SETTLEMENT_HOST=127.0.0.1
ORF_LOCAL_SETTLEMENT_PORT=8799
# Shared Ory/MinIO connection. Use the shared connection package to copy the CA cert
# into .orf/shared-infra/certs/orf-public-ca.crt and populate the MinIO secret.
ORY_PUBLIC_URL=https://182.150.118.137:18443
# Required only when deleting a linked user account, because Ory identity deletion uses the Kratos admin API.
# ORY_ADMIN_URL=http://127.0.0.1:4434
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://182.150.118.137:19443
ORF_PUBLIC_CA_CERT=./.orf/shared-infra/certs/orf-public-ca.crt
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=orf-comment-attachments
OBJECT_STORAGE_ACCESS_KEY=orf-app
OBJECT_STORAGE_SECRET_KEY=replace-with-shared-minio-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_UPLOAD_MAX_BYTES=10485760

# Public-infra operator settings. Keep commented unless you are preparing the shared host.
# ORF_PUBLIC_IP=203.0.113.10
# ORY_PUBLIC_EXTERNAL_PORT=18443
# OBJECT_STORAGE_EXTERNAL_PORT=19443
# ORY_COOKIE_SECRET=replace-with-random-48-byte-secret
# ORY_CIPHER_SECRET=replace-with-random-32-char-secret
# MINIO_ROOT_USER=orf-root
# MINIO_ROOT_PASSWORD=replace-with-strong-local-secret

# Mattermost connection shared by optional backend integrations.
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_LOGIN_ID=orf-bot@example.com
MATTERMOST_PASSWORD=change-me

# GitHub push/issues -> Mattermost ORF channel relay.
MATTERMOST_CHANNEL_ID=replace-me
GITHUB_REPOSITORY_FULL_NAME=xueyu888/ORF
GITHUB_SYNC_ENABLED=false
# Kept for old deployments; current sync watches every branch.
GITHUB_SYNC_BRANCH=*
GITHUB_SYNC_INTERVAL_SECONDS=60
GITHUB_SYNC_LOOKBACK=20
GITHUB_SYNC_STATE_FILE=.artifacts/github-sync-state.json
# Used automatically when GitHub API is rate limited.
GITHUB_SYNC_GIT_REMOTE=origin
GITHUB_ISSUES_SYNC_ENABLED=false
GITHUB_ISSUES_SYNC_INTERVAL_SECONDS=300
GITHUB_ISSUES_SYNC_LOOKBACK=50
# Optional, useful for private repos or higher GitHub API rate limits.
# GITHUB_TOKEN=replace-me
# Optional, only needed if enabling GitHub inbound webhooks in a public deployment.
# GITHUB_WEBHOOK_SECRET=replace-me-with-random-32-byte-string

# GitLab develop projects -> Mattermost GitLab plugin webhook reconciler.
# This keeps every project under one GitLab group wired to the Mattermost GitLab plugin.
GITLAB_MATTERMOST_WEBHOOK_RECONCILE_ENABLED=false
GITLAB_URL=https://gitlab.example.com
GITLAB_USER=gitlab-admin-user
GITLAB_MATTERMOST_WEBHOOK_RECONCILE_GROUP=develop
GITLAB_MATTERMOST_WEBHOOK_RECONCILE_INTERVAL_SECONDS=60
# Prefer a dedicated GitLab access token in production.
# GITLAB_MATTERMOST_WEBHOOK_RECONCILE_ACCESS_TOKEN=replace-with-gitlab-api-token
# Local fallback: read the matching GitLab username/password from a git credential store.
# GITLAB_MATTERMOST_WEBHOOK_RECONCILE_CREDENTIALS_FILE=/home/user/.git-credentials
GITLAB_MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/plugins/com.github.manland.mattermost-plugin-gitlab/webhook
# Prefer a direct secret in production. The config-file fallback is useful when managing an existing local Mattermost deployment.
# GITLAB_MATTERMOST_WEBHOOK_SECRET=replace-with-mattermost-gitlab-plugin-webhook-secret
# GITLAB_MATTERMOST_WEBHOOK_SECRET_CONFIG_FILE=/opt/mattermost/config/config.json
GITLAB_MATTERMOST_WEBHOOK_RECONCILE_PUSH_EVENT_HOOKS_LIMIT=1000

# Daily Jira reminder -> private DM to each active member of a source Mattermost channel.
MATTERMOST_JIRA_REMINDER_ENABLED=false
MATTERMOST_JIRA_REMINDER_BOT_TOKEN=replace-with-dedicated-bot-token
# Optional fallback if using a dedicated reminder login instead of a bot token.
# MATTERMOST_JIRA_REMINDER_LOGIN_ID=orf-jira-reminder@example.com
# MATTERMOST_JIRA_REMINDER_PASSWORD=change-me
MATTERMOST_JIRA_REMINDER_SOURCE_CHANNEL_ID=replace-with-llm-application-group-channel-id
MATTERMOST_JIRA_REMINDER_TIME=17:00
MATTERMOST_JIRA_REMINDER_TIME_ZONE=Asia/Shanghai
MATTERMOST_JIRA_REMINDER_MESSAGE=今天 {{time}} 了，请记得填写 Jira Tempo：[打开 Tempo]({{tempoUrl}})
MATTERMOST_JIRA_REMINDER_CHECK_INTERVAL_SECONDS=30
MATTERMOST_JIRA_REMINDER_REQUIRE_BOT=true
MATTERMOST_JIRA_REMINDER_SKIP_BOTS=true
MATTERMOST_JIRA_REMINDER_STATE_FILE=.artifacts/mattermost-jira-reminder-state.json
JIRA_TEMPO_MY_WORK_URL="https://jira.example.com/secure/Tempo.jspa#/my-work/week?type=LIST"

# SMTP email notifications.
TDX_MAIL_SMTP_HOST=smtp.example.com
TDX_MAIL_SMTP_PORT=465
TDX_MAIL_SMTP_USER=notifications@example.com
TDX_MAIL_SMTP_PASS=change-me
TDX_MAIL_FROM="ORF <notifications@example.com>"
TDX_MAIL_TO=owner@example.com
# Optional; defaults to true for port 465 and false for other ports.
# TDX_MAIL_SMTP_SECURE=true
