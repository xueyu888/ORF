# Local WSL PostgreSQL rehearsal defaults.
# Keep this file out of ORF runtime env; copy it to postgres.env for compose.

ORF_POSTGRES_DB=orf
ORF_POSTGRES_USER=orf_project_user
ORF_POSTGRES_PASSWORD=replace-me
ORF_POSTGRES_DATA_DIR=/mnt/data1/orf/postgres

# Rehearsal uses 55432 so the Windows PostgreSQL service can keep 5432.
# For final cutover, stop/disable the Windows service first, then set 5432.
ORF_POSTGRES_PORT=55432
