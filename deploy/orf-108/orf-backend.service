[Unit]
Description=ORF Backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/data1/orf/app
EnvironmentFile=/mnt/data1/orf/secrets/orf.env
Environment=PATH=/opt/orf/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/orf/node/bin/npm run server:start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
