[Unit]
Description=ORF Backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/data1/orf/releases/current
EnvironmentFile=/mnt/data1/orf/secrets/orf.env
Environment=PATH=/opt/orf/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/orf/node/bin/node server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
