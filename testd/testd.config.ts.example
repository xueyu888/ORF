export type TestdCaseChangePolicy = "open" | "locked";

export type TestdCaseConfig = {
  id: string;
  title: string;
  doc: string;
  changePolicy: TestdCaseChangePolicy;
  enabled: boolean;
  fixtureLifecycle?: "isolated" | "legacy-base-data";
  traceability?: "verified";
  spec?: string;
};

// Keep this list in the same order as testd-doc/cases/测试用例集合.md.
export const testdCases = [
  {
    id: "reward-hall.member-apply-challenge",
    title: "非指挥官可以主动申请挑战",
    doc: "testd-doc/cases/并行/01 Reward Hall/target/非指挥官可以主动申请挑战.md",
    changePolicy: "open",
    spec: "testd/并行/01 Reward Hall/target/member-apply-challenge/_entry/member-apply-challenge.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "reward-hall.member-accept-recruited-challenge",
    title: "被征召挑战者成功接受挑战",
    doc: "testd-doc/cases/并行/01 Reward Hall/target/被征召挑战者成功接受挑战.md",
    changePolicy: "open",
    spec: "testd/并行/01 Reward Hall/target/member-accept-recruited-challenge/_entry/member-accept-recruited-challenge.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "reward-hall.member-enter-participated-target",
    title: "普通成员对已参与目标可进入并查看",
    doc: "testd-doc/cases/并行/01 Reward Hall/target/普通成员对已参与目标可进入并查看.md",
    changePolicy: "open",
    spec: "testd/并行/01 Reward Hall/target/member-enter-participated-target/_entry/member-enter-participated-target.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "target.admin-create-target-publish",
    title: "管理员可以新建目标并发布",
    doc: "testd-doc/cases/并行/02 My Challenge/target/管理员可以新建目标并发布.md",
    changePolicy: "open",
    spec: "testd/并行/02 My Challenge/target/admin-create-target-publish/_entry/admin-create-target-publish.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "target.member-create-target-forbidden",
    title: "普通用户不允许新建目标",
    doc: "testd-doc/cases/并行/02 My Challenge/target/普通用户不允许新建目标.md",
    changePolicy: "open",
    spec: "testd/并行/02 My Challenge/target/member-create-target-forbidden/_entry/member-create-target-forbidden.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
] satisfies TestdCaseConfig[];

const enabledCasesWithoutSpec = testdCases.filter((testdCase) => testdCase.enabled && !testdCase.spec);
if (enabledCasesWithoutSpec.length > 0) {
  throw new Error(
    `testd config enabled cases without spec: ${enabledCasesWithoutSpec
      .map((testdCase) => `${testdCase.id} (${testdCase.title})`)
      .join(", ")}`,
  );
}

const enabledCasesWithoutTraceability = testdCases.filter(
  (testdCase) => testdCase.enabled && testdCase.traceability !== "verified",
);
if (enabledCasesWithoutTraceability.length > 0) {
  throw new Error(
    `testd config enabled cases without verified traceability: ${enabledCasesWithoutTraceability
      .map((testdCase) => `${testdCase.id} (${testdCase.title})`)
      .join(", ")}`,
  );
}

const executableCasesWithoutIsolatedFixtures = testdCases.filter(
  (testdCase) =>
    (testdCase.enabled || testdCase.traceability === "verified") &&
    testdCase.fixtureLifecycle !== "isolated",
);
if (executableCasesWithoutIsolatedFixtures.length > 0) {
  throw new Error(
    `testd config executable cases without isolated fixture lifecycle: ${executableCasesWithoutIsolatedFixtures
      .map((testdCase) => `${testdCase.id} (${testdCase.title})`)
      .join(", ")}`,
  );
}

export const disabledTestdSpecGlobs = testdCases
  .filter((testdCase) => testdCase.spec && !testdCase.enabled)
  .map((testdCase) => `**/${testdCase.spec}`);
