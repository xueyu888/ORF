export type TestdCaseChangePolicy = "open" | "locked";

export type TestdCaseConfig = {
  id: string;
  title: string;
  doc: string;
  changePolicy: TestdCaseChangePolicy;
  enabled: boolean;
  fixtureLifecycle?: "isolated" | "legacy-base-data";
  traceability?: "verified";
  spec?: string;
};

// Keep this list in the same order as testd-doc/cases/测试用例集合.md.
export const testdCases = [
  {
    id: "tasks.member-delete-task",
    title: "参与的普通成员在执行中支持删除行动项",
    doc: "testd-doc/cases/并行/My Challenge/action item/参与的普通成员在执行中支持删除行动项.md",
    changePolicy: "open",
    spec: "testd/并行/My Challenge/action item/member-delete-task/_entry/member-delete-task.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "tasks.member-delete-task-active-forbidden",
    title: "非参与的普通成员在执行中不支持删除行动项",
    doc: "testd-doc/cases/并行/My Challenge/action item/非参与的普通成员在执行中不支持删除行动项.md",
    changePolicy: "open",
    spec: "testd/并行/My Challenge/action item/member-delete-task-active-forbidden/_entry/member-delete-task-active-forbidden.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "tasks.member-delete-task-reestimate",
    title: "参与的普通成员在重估中支持删除行动项",
    doc: "testd-doc/cases/并行/My Challenge/action item/参与的普通成员在重估中支持删除行动项.md",
    changePolicy: "open",
    spec: "testd/并行/My Challenge/action item/member-delete-task-reestimate/_entry/member-delete-task-reestimate.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "tasks.member-delete-task-reestimate-forbidden",
    title: "非参与的普通成员在重估中不支持删除行动项",
    doc: "testd-doc/cases/并行/My Challenge/action item/非参与的普通成员在重估中不支持删除行动项.md",
    changePolicy: "open",
    spec: "testd/并行/My Challenge/action item/member-delete-task-reestimate-forbidden/_entry/member-delete-task-reestimate-forbidden.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "tasks.admin-delete-task-active",
    title: "管理员在执行中支持删除行动项",
    doc: "testd-doc/cases/并行/My Challenge/action item/管理员在执行中支持删除行动项.md",
    changePolicy: "open",
    spec: "testd/并行/My Challenge/action item/admin-delete-task-active/_entry/admin-delete-task-active.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
  {
    id: "tasks.admin-delete-task-reestimate",
    title: "管理员在重估中支持删除行动项",
    doc: "testd-doc/cases/并行/My Challenge/action item/管理员在重估中支持删除行动项.md",
    changePolicy: "open",
    spec: "testd/并行/My Challenge/action item/admin-delete-task-reestimate/_entry/admin-delete-task-reestimate.spec.ts",
    enabled: true,
    fixtureLifecycle: "isolated",
    traceability: "verified",
  },
] satisfies TestdCaseConfig[];

const enabledCasesWithoutSpec = testdCases.filter((testdCase) => testdCase.enabled && !testdCase.spec);
if (enabledCasesWithoutSpec.length > 0) {
  throw new Error(
    `testd config enabled cases without spec: ${enabledCasesWithoutSpec
      .map((testdCase) => `${testdCase.id} (${testdCase.title})`)
      .join(", ")}`,
  );
}

const enabledCasesWithoutTraceability = testdCases.filter(
  (testdCase) => testdCase.enabled && testdCase.traceability !== "verified",
);
if (enabledCasesWithoutTraceability.length > 0) {
  throw new Error(
    `testd config enabled cases without verified traceability: ${enabledCasesWithoutTraceability
      .map((testdCase) => `${testdCase.id} (${testdCase.title})`)
      .join(", ")}`,
  );
}

const executableCasesWithoutIsolatedFixtures = testdCases.filter(
  (testdCase) =>
    (testdCase.enabled || testdCase.traceability === "verified") &&
    testdCase.fixtureLifecycle !== "isolated",
);
if (executableCasesWithoutIsolatedFixtures.length > 0) {
  throw new Error(
    `testd config executable cases without isolated fixture lifecycle: ${executableCasesWithoutIsolatedFixtures
      .map((testdCase) => `${testdCase.id} (${testdCase.title})`)
      .join(", ")}`,
  );
}

export const disabledTestdSpecGlobs = testdCases
  .filter((testdCase) => testdCase.spec && !testdCase.enabled)
  .map((testdCase) => `**/${testdCase.spec}`);
